# Agent Kit POC — environment template.
#
# Copy to `.env` (never commit it) and export before running the agent:
#
#   cp .env.example .env
#   set -a && source .env && set +a
#   agent-kit doctor
#
# Secrets are environment variables ONLY. `.agent/config.yaml` must never
# contain credentials.

# Required when model.provider is "openai".
OPENAI_API_KEY=

# Optional: override the API endpoint (Azure OpenAI, proxies, local gateways).
# OPENAI_BASE_URL=

# Optional: default model name used when `.agent/config.yaml` has no model.name.
# AGENT_KIT_MODEL=
